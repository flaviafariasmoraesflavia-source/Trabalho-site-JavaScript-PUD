    <script>
        const PRODUCTS = {
            'perifericos': [
                { id: 'peri-1', name: 'Teclado Mecânico', price: 450.00, image: 'img/peri1.jpg', description: 'Teclado mecânico de alta precisão para gamers e programadores.', fullDescription: 'Teclado com switches azuis, iluminação RGB personalizável, e design ergonômico. Resposta tátil e sonora ideal para digitação e jogos. Construção robusta e durável.' },
                { id: 'peri-2', name: 'Mouse Gamer', price: 250.00, image: 'img/peri2.jpg', description: 'Mouse com sensor óptico de alta precisão.', fullDescription: 'Mouse com sensor óptico de alta precisão, iluminação RGB, botões programáveis e design ergonômico. Ideal para sessões de jogo longas e intensas.' },
                { id: 'peri-3', name: 'Mousepad Gamer', price: 80.00, image: 'img/peri3.jpg', description: 'Mousepad de tecido, grande e com bordas costuradas.', fullDescription: 'Mousepad de tecido com superfície otimizada para sensores ópticos e a laser. Grande o suficiente para movimentos amplos, com bordas costuradas que previnem o desgaste.' },
                { id: 'peri-4', name: 'Webcam HD', price: 120.00, image: 'img/peri4.jpg', description: 'Webcam com resolução 1080p e microfone embutido.', fullDescription: 'Webcam com resolução Full HD (1080p), ideal para videochamadas e streaming. Possui foco automático e microfone embutido com cancelamento de ruído.' },
                { id: 'peri-5', name: 'Headset Gamer', price: 350.00, image: 'img/peri5.jpg', description: 'Headset com som surround e microfone removível.', fullDescription: 'Headset com som surround virtual 7.1 para uma experiência de áudio imersiva em jogos. Microfone removível com cancelamento de ruído e almofadas macias para conforto prolongado.' },
                { id: 'peri-6', name: 'Microfone Condensador', price: 280.00, image: 'img/peri6.jpg', description: 'Microfone de estúdio para gravações de alta qualidade.', fullDescription: 'Microfone condensador USB, ideal para podcasting, streaming e gravação de voz. Capta áudio de alta qualidade com clareza e precisão. Inclui tripé e filtro pop.' },
                { id: 'peri-7', name: 'Cadeira Gamer', price: 950.00, image: 'img/peri7.jpg', description: 'Cadeira ergonômica com ajustes de altura e inclinação.', fullDescription: 'Cadeira ergonômica com design gamer, revestida em couro sintético de alta qualidade. Possui apoio para os braços ajustável, almofadas para lombar e pescoço, e inclinação de até 180 graus.' },
                { id: 'peri-8', name: 'Kit Teclado e Mouse', price: 180.00, image: 'img/peri8.jpg', description: 'Kit sem fio com teclado e mouse para uso diário.', fullDescription: 'Kit de teclado e mouse sem fio com conexão plug and play. O teclado é silencioso e o mouse possui sensor óptico preciso. Ideal para uso em escritório ou estudo.' },
                { id: 'peri-9', name: 'Hub USB', price: 50.00, image: 'img/peri9.jpg', description: 'Hub USB com 4 portas de alta velocidade.', fullDescription: 'Hub USB 3.0 de 4 portas, expande a conectividade do seu computador. Permite conectar vários dispositivos USB, como pendrives, mouses e teclados, simultaneamente.' },
                { id: 'peri-10', name: 'Base Refrigeradora', price: 110.00, image: 'img/peri10.jpg', description: 'Base para notebook com ventoinhas para resfriamento.', fullDescription: 'Base refrigeradora com duas ventoinhas de alta potência para manter seu notebook na temperatura ideal durante uso intenso. Possui design ergonômico e ajuste de altura.' }
            ],
        };
        
        const saveCart = (cart) => localStorage.setItem('cart', JSON.stringify(cart));
        const getCart = () => JSON.parse(localStorage.getItem('cart')) || {};

        const findProductById = (id) => {
            for (const category in PRODUCTS) {
                const product = PRODUCTS[category].find(p => p.id === id);
                if (product) return product;
            }
            return null;
        };

        const updateCartCounter = () => {
            const cart = getCart();
            const counterElement = document.getElementById('cart-counter');
            const totalItems = Object.values(cart).reduce((sum, item) => sum + item.quantity, 0);
            
            counterElement.textContent = totalItems;
            counterElement.style.display = totalItems > 0 ? 'flex' : 'none';
        };

        window.adicionarAoCarrinho = (itemId, itemName, itemPrice, quantity = 1) => {
            const cart = getCart();
            
            if (cart[itemId]) {
                cart[itemId].quantity += quantity;
            } else {
                const product = findProductById(itemId);
                if (product) {
                    cart[itemId] = { ...product, quantity: quantity };
                } else {
                    cart[itemId] = { id: itemId, name: itemName, price: itemPrice, quantity: quantity, image: 'img/placeholder.jpg' };
                }
            }
            saveCart(cart);
            alert(`"${itemName}" foi adicionado ao carrinho!`);
            updateCartCounter();
        };

        document.addEventListener('DOMContentLoaded', () => {
            const hamburger = document.getElementById('hamburger-menu');
            const sidebar = document.getElementById('sidebar');
            const themeSwitch = document.getElementById('theme-switch');

            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.body.classList.add('dark-mode');
                themeSwitch.checked = true;
            }

            hamburger.addEventListener('click', () => sidebar.classList.toggle('open'));
            themeSwitch.addEventListener('change', () => {
                if (themeSwitch.checked) {
                    document.body.classList.add('dark-mode');
                    localStorage.setItem('theme', 'dark');
                } else {
                    document.body.classList.remove('dark-mode');
                    localStorage.setItem('theme', 'light');
                }
            });
            
            updateCartCounter();
        });
    </script>
